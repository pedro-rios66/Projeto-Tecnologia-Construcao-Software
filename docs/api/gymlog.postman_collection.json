    {
      "name": "4. Erros",
      "item": [
        {
          "name": "400 — dado inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Erro no formato padrão { error }\", () => {",
                  "  const corpo = pm.response.json();",
                  "  pm.expect(Object.keys(corpo)).to.eql([\"error\"]);",
                  "  pm.expect(corpo.error).to.be.a(\"string\");",
                  "});",
                  "pm.test(\"Mensagem da validação\", () => pm.expect(pm.response.json().error).to.eql(\"O nome do treino não pode estar vazio.\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
