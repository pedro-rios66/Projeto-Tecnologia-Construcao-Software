            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Desenvolvimento com Halteres\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workouts/{{idTreino}}/exercises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workouts",
                "{{idTreino}}",
                "exercises"
              ]
            }
          }
        },
        {
          "name": "Registrar série",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const exercicio = pm.response.json().exercicios.find((e) => e.id == pm.collectionVariables.get(\"idExercicio\"));",
                  "pm.test(\"Série numerada pelo servidor\", () => pm.expect(exercicio.series[0].numero).to.eql(1));",
                  "pm.collectionVariables.set(\"idSerie\", exercicio.series[exercicio.series.length - 1].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"peso\": 14,\n  \"repeticoes\": 12\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workouts/{{idTreino}}/exercises/{{idExercicio}}/sets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workouts",
                "{{idTreino}}",
                "exercises",
                "{{idExercicio}}",
                "sets"
              ]
            }
          }
        },
        {
          "name": "Marcar série como feita",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"feita\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workouts/{{idTreino}}/exercises/{{idExercicio}}/sets/{{idSerie}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workouts",
                "{{idTreino}}",
                "exercises",
                "{{idExercicio}}",
                "sets",
                "{{idSerie}}"
              ]
            }
          }
        },
        {
          "name": "Remover série",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workouts/{{idTreino}}/exercises/{{idExercicio}}/sets/{{idSerie}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workouts",
                "{{idTreino}}",
                "exercises",
                "{{idExercicio}}",
                "sets",
                "{{idSerie}}"
              ]
            }
          }
        },
        {
          "name": "Remover exercício",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workouts/{{idTreino}}/exercises/{{idExercicio}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workouts",
                "{{idTreino}}",
                "exercises",
                "{{idExercicio}}"
              ]
            }
          }
        }
      ]
    },
