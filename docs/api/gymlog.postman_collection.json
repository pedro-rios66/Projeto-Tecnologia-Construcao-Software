{
  "info": {
    "name": "GymLog API",
    "description": "API REST do GymLog (Etapa 06). Inicie o servidor com `python server/server.py` e execute as pastas em ordem: as requisições de criação guardam os ids usados nas seguintes. Documentação: docs/api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "idTreino",
      "value": ""
    },
    {
      "key": "idExercicio",
      "value": ""
    },
    {
      "key": "idSerie",
      "value": ""
    },
    {
      "key": "idSessao",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Treinos (recurso principal)",
      "item": [
        {
          "name": "Listar treinos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devolve uma lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workouts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workouts"
              ]
            }
          }
        },
        {
          "name": "Criar treino",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Cabeçalho Location aponta para o treino criado\", () =>",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/workouts/\" + pm.response.json().id));",
                  "const treino = pm.response.json();",
                  "pm.collectionVariables.set(\"idTreino\", treino.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Treino D\",\n  \"descricao\": \"Ombros + Abdômen\",\n  \"dias\": [\n    2,\n    5\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workouts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workouts"
              ]
            }
          }
        },
        {
          "name": "Consultar treino",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"É o treino criado\", () => pm.expect(pm.response.json().nome).to.eql(\"Treino D\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workouts/{{idTreino}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workouts",
                "{{idTreino}}"
              ]
            }
          }
        },
        {
          "name": "Alterar treino",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Dados alterados\", () => pm.expect(pm.response.json().dias).to.eql([2]));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Treino D\",\n  \"descricao\": \"Ombros\",\n  \"dias\": [\n    2\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workouts/{{idTreino}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workouts",
                "{{idTreino}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Exercícios e séries",
      "item": [
        {
          "name": "Adicionar exercício",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const treino = pm.response.json();",
                  "pm.collectionVariables.set(\"idExercicio\", treino.exercicios[treino.exercicios.length - 1].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
